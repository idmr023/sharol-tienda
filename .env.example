# PostgreSQL (Neon / Render). Reemplaza con tu cadena de conexión real.
DATABASE_URL="postgresql://usuario:password@ep-xxxx.neon.tech/neondb?sslmode=require"

# JWT secrets para autenticación (cámbialas en producción)
JWT_ACCESS_SECRET="sharol-tienda-access-key-2026-change-me"
JWT_REFRESH_SECRET="sharol-tienda-refresh-key-2026-change-me"

# API Key de Resend para envío de comprobantes a Sharol (opcional si usas SMTP)
RESEND_API_KEY=""
SHAROL="sharol@sharol.tienda"
MAIL_FROM="Sharol Tienda <onboarding@resend.dev>"

# Configuración SMTP para envío de correos (Google Gmail u otro)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Sharol Tienda <your-email@gmail.com>"
RECEIPT_RECIPIENT="recipient@example.com"  # Email donde se enviarán datos de comprobantes

# API Key de OpenRouter (opencode la usa para los modelos openrouter/*)
OPENROUTER_API_KEY="sk-or-v1-tu-key-aqui"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String              @id @default(uuid())
  name         String
  email        String              @unique
  phone        String?
  passwordHash String
  salt         String
  role         String              @default("CUSTOMER") // CUSTOMER, ADMIN
  active       Boolean             @default(true)
  sessions     Session[]
  reviews      Review[]
  wishlist     WishlistItem[]
  orders       Order[]
  resetTokens  PasswordResetToken[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, ip])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Review {
  id        String   @id @default(uuid())
  name      String
  city      String
  rating    Int      @default(5)
  comment   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String
  price       Float
  stock       Int         @default(0)
  images      String      // JSON array or comma separated list of image URLs
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  wishlist    WishlistItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id              String              @id @default(uuid())
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  city            String
  totalAmount     Float
  status          String              @default("SOLICITADO") // SOLICITADO, CONFIRMADO, EN_PREPARACION, ENVIADO, ENTREGADO, CANCELADO
  paymentMethod   String              @default("DELIVERY") // YAPE, PLIN, DELIVERY
  voucherUrl      String?             // Comprobante de pago persistido (data URL / path)
  tracking        String?             // Número de seguimiento del courier
  adminNote       String?             // Notas internas de la administradora
  userId          String?
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  createdAt       DateTime            @default(now())

  @@index([userId])
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}
